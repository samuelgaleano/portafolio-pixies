# Captación de leads (server-only: sin NEXT_PUBLIC — nunca llegan al navegador).
# Cómo obtener ambos valores: apps-script/DESPLIEGUE.md

# URL /exec del Google Apps Script desplegado como Web App
LEADS_WEBHOOK_URL=

# Mismo secreto que pusiste en Code.gs (var SECRET)
LEADS_SECRET=

# Demo lite de escuchacomprendiendo.ai (server-only): cuenta Groq DEDICADA a esta demo,
# separada del uso personal del producto real — así el tráfico del portafolio nunca compite
# por cuota. Se genera gratis en console.groq.com/keys.
GROQ_API_KEY=
